# chimerax_class1_AF.cxc
# Class I fumarase — FumA AlphaFold model (UniProt: P0AC33)
# Active site: Cys105, Cys224, Cys318 (Fe-S cluster coordination)
#
# Run headless:
#   chimerax --nogui --script chimerax_class1_AF.cxc
# Run interactively:
#   open chimerax_class1_AF.cxc

# --- 1. Load AlphaFold model ---
open https://alphafold.ebi.ac.uk/files/AF-P0AC33-F1-model_v6.pdb

# --- 2. Visual styling ---
set bgColor white
color #1 palegreen
cartoon style width 1.0 thickness 0.3

# --- 3. Active site: Fe-S coordinating cysteines ---
select #1:105,224,318
style sel sphere
size sel atomRadius 1.4
color sel orangered
color sel byhet
~select

# --- 4. Surface on active site pocket ---
surface #1:105,224,318 enclose #1:105,224,318
transparency 40 #1:105,224,318

# --- 5. Publication lighting ---
lighting soft
graphics silhouettes true width 1.5

# --- 6. Adjust view ---
view #1
zoom 0.85

# --- 7. Save session ---
save STRUCTURE_DIR/FumA_ClassI_analysis.cxs

# --- 8. Export image ---
save STRUCTURE_DIR/FumA_ClassI.png width 2400 height 1800 supersample 3 transparentBackground false
