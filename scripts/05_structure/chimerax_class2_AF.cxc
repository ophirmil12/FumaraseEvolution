# chimerax_class2_AF.cxc
# Class II fumarase — FumC AlphaFold model (UniProt: P05042)
# Active site: His188, Ser318, Lys324, Glu331
#
# Run headless:
#   chimerax --nogui --script chimerax_class2_AF.cxc
# Run interactively:
#   open chimerax_class2_AF.cxc

# --- 1. Load AlphaFold model ---
open https://alphafold.ebi.ac.uk/files/AF-P05042-F1-model_v6.pdb

# --- 2. Visual styling ---
set bgColor white
color #1 palegreen
cartoon style width 1.0 thickness 0.3

# --- 3. Active site ---
select #1:188,318,324,331
style sel sphere
size sel atomRadius 1.4
color sel orangered
color sel byhet
~select

# --- 4. Surface on active site pocket ---
surface #1:188,318,324,331 enclose #1:188,318,324,331
transparency 40 #1:188,318,324,331

# --- 5. Publication lighting ---
lighting soft
graphics silhouettes true width 1.5

# --- 6. Adjust view ---
view #1
zoom 0.9

# --- 7. Save session ---
save STRUCTURE_DIR/FumC_ClassII_analysis.cxs

# --- 8. Export image ---
save STRUCTURE_DIR/FumC_ClassII.png width 2400 height 1800 supersample 3 transparentBackground false
